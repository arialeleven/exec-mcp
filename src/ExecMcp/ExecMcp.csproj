<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ExecMcp</RootNamespace>
    <AssemblyName>exec-mcp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="Ignore" Version="0.2.1" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <!-- 8.x is MIT; 9.x+ NuGet binaries ship under a maintenance-fee EULA (see third_party/README.md). -->
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sdk/**" Exclude="sdk/**/__pycache__/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="examples/**;sdk/**" />
  </ItemGroup>

  <!-- The node SDK ships zod; install it once if missing (needs npm, only for node plugins). -->
  <Target Name="NodeSdkDeps" BeforeTargets="BeforeBuild" Condition="!Exists('sdk/node/node_modules/zod')">
    <Exec Command="npm install --omit=dev --no-audit --no-fund" WorkingDirectory="sdk/node" ContinueOnError="true" />
    <ItemGroup>
      <None Include="sdk/node/node_modules/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
