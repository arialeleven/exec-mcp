[Unit]
Description=TLS SNI router for port 443
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sni-router -config /etc/sni-router/config.json
Restart=always
RestartSec=2
DynamicUser=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
